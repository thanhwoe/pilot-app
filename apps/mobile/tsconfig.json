{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // No ambient @types by default, so Jest's globals (hoisted into node_modules/@types) don't
    // type-check in app code. The tests get them from tsconfig.test.json.
    "types": [],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "android",
    "ios",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
