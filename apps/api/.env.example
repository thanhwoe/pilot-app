DATABASE_URL=postgres://gop:gop@localhost:5432/gop
PORT=3001
# Comma-separated origins allowed by CORS (the web app in development).
CORS_ORIGINS=http://localhost:3000
# Key for hashing sign-in codes and session tokens, at least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters
# The dev code endpoint needs NODE_ENV set to exactly development or test; unset or any other value turns it off.
NODE_ENV=development
# Set to true to expose GET /dev/sign-in-code for automated UI tests. Off by default.
DEV_SIGN_IN_CODES=false
# Resend API key. When set, sign-in codes go by email from onboarding@resend.dev, which Resend
# delivers only to the key owner's own address. Empty: the code goes to the API log. Never commit a key.
RESEND_API_KEY=
