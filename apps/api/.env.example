DATABASE_URL=postgres://gop:gop@localhost:5432/gop
PORT=3001
# Comma-separated origins allowed by CORS (the web app in development).
CORS_ORIGINS=http://localhost:3000
# Key for hashing sign-in codes and session tokens, at least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters
